  create  table "airflow"."driven_trusted"."technical_data__dbt_tmp"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT 
        fnu.unique_id, 
        da.address, 
        da.mac_address, 
        da.ip_address, 
        fnu.download_speed, 
        fnu.upload_speed, 
        ROUND((fnu.session_duration/60), 1) as min_session_duration,
        CASE
            WHEN fnu.download_speed < 50 OR fnu.upload_speed < 30 OR
            fnu.session_duration/60 < 1 THEN true
            ELSE false
        END AS technical_issue
    FROM "airflow"."driven_staging"."fact_network_usage" as fnu
    JOIN "airflow"."driven_staging"."dim_address" as da ON fnu.unique_id = da.unique_id
)

SELECT *
FROM source_data
  );
  
