  create  table "airflow"."driven_trusted"."payment_data__dbt_tmp"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT fnu.unique_id, df.iban, fnu.download_speed, fnu.upload_speed, fnu.session_duration, fnu.consumed_traffic,
    ((fnu.download_speed + fnu.upload_speed + 1)/2) + (fnu.consumed_traffic / (fnu.session_duration + 1)) AS payment_amount
    FROM "airflow"."driven_staging"."fact_network_usage" as fnu
    JOIN "airflow"."driven_staging"."dim_finance" as df ON fnu.unique_id = df.unique_id
)

SELECT *
FROM source_data
  );
  
